# Honeybadger relay-training public demo (Cloudflare Pages headers)
# App code + data always revalidate so shipped fixes appear immediately.
/relay/*
  Cache-Control: no-cache

# Heavy static media (photos, CAD models, cut-sheet PDFs) may cache a day.
/relay/assets/*
  Cache-Control: public, max-age=86400

# Bounty Board (EVE Frontier mod): always revalidate, so a new build reaches players at once.
/frontier/bounty/*
  Cache-Control: no-cache

# EVE Frontier hub page: always revalidate (screenshots are plain files under /frontier/assets/shots/).
/frontier/
  Cache-Control: no-cache
/frontier/index.html
  Cache-Control: no-cache

# Homepage: always revalidate so a shipped change reaches visitors at once (art is version-stamped).
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache

/frontier/warroom/
  Cache-Control: no-cache
/frontier/warroom/index.html
  Cache-Control: no-cache

# Rust HUD art (HoneyBadger DPS Meter): every Rust client downloads these PNGs by URL; file names and the ?v= tag
# are versioned, so they can cache for a year. Never overwrite a published file - publish a new name or bump the tag.
/assets/hud/v1/*
  Cache-Control: public, max-age=31536000, immutable
